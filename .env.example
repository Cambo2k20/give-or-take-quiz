# Both values are safe to publish: the publishable key only ever reaches the
# database through row level security, which allows public reads and nothing
# else. The GitHub Pages workflow needs these set as repository variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Development only. Incubating subjects remain disabled unless they contain at
# least five bundled questions; production builds ignore this override.
VITE_ENABLE_INCUBATING_CATEGORIES=false
