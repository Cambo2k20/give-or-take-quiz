# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# build output
/dist/
/coverage/

# vite
/.vite/
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local scratch
/work/
/outputs/
/.npm-cache/
# Supabase Studio saves ad-hoc queries here; they are not project source
/supabase/snippets/

# leftovers from the pre-Vite toolchain; safe to delete from your checkout
/.vinext/
/.wrangler/
